{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "London cinema collector fallback for GitHub HTTP 403",
  "Parameters": {
    "ImageUri": {
      "Type": "String"
    },
    "FunctionName": {
      "Type": "String",
      "Default": "london-cinema-collector"
    },
    "GitHubRoleName": {
      "Type": "String",
      "Default": "london-cinema-alert-collector"
    }
  },
  "Resources": {
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${FunctionName}"
        },
        "RetentionInDays": 7
      }
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "CollectorLogs",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Logs",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          },
          {
            "PolicyName": "InvokeCinemaAlert",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "lambda:InvokeFunction"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:london-cinema-alert"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "AsyncPolicy": {
      "Type": "AWS::Lambda::EventInvokeConfig",
      "Properties": {
        "FunctionName": {
          "Ref": "Collector"
        },
        "Qualifier": "$LATEST",
        "MaximumRetryAttempts": 0,
        "MaximumEventAgeInSeconds": 60
      }
    },
    "Collector": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Ref": "FunctionName"
        },
        "Description": "Camoufox fallback collector with acknowledged receiver delivery",
        "PackageType": "Image",
        "Code": {
          "ImageUri": {
            "Ref": "ImageUri"
          }
        },
        "Architectures": [
          "arm64"
        ],
        "MemorySize": 2048,
        "Timeout": 60,
        "EphemeralStorage": {
          "Size": 512
        },
        "Role": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "uk-cinema-collector"
          },
          {
            "Key": "Purpose",
            "Value": "github-403-fallback"
          }
        ],
        "Environment": {
          "Variables": {
            "RECEIVER_FUNCTION": "london-cinema-alert"
          }
        }
      }
    },
    "GitHubInvokePolicy": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "invoke-london-cinema-collector",
        "Roles": [
          {
            "Ref": "GitHubRoleName"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "lambda:InvokeFunction"
              ],
              "Resource": {
                "Fn::GetAtt": [
                  "Collector",
                  "Arn"
                ]
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "FunctionName": {
      "Value": {
        "Ref": "Collector"
      }
    },
    "LogGroup": {
      "Value": {
        "Ref": "Logs"
      }
    }
  }
}
