{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "uk-cinema-patchright-scheduler",
  "main": "src/patchright.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "GITHUB_REPOSITORY": "jukyeong-git/uk-cinema-collector",
    "ENABLED": "true",
    "DELIVER": "false"
  },
  "triggers": {
    "crons": [
      "*/1 * * * *"
    ]
  }
}
