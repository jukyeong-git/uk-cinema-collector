{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "uk-cinema-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "GITHUB_REPOSITORY": "jukyeong-git/uk-cinema-collector",
    "ENABLED": "false",
    "DELIVER": "true"
  },
  "triggers": {
    "crons": []
  }
}
